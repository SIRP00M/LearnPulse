{
  "name": "learnpulse-web",
  "private": true,
  "version": "0.1.0-beta.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "e2e": "node scripts/private-e2e-not-included.mjs",
    "scan": "node scripts/secret-scan.mjs",
    "preview": "node scripts/serve-dist.mjs",
    "headers": "node scripts/write-headers.mjs",
    "build:deploy": "npm run build && npm run headers && npm run scan",
    "build:mock": "vite build --outDir dist-mock",
    "e2e:i18n": "playwright test -c playwright.i18n.config.ts"
  },
  "dependencies": {
    "@fontsource/material-icons-outlined": "5.3.0",
    "@fontsource/noto-sans-thai": "5.3.0",
    "@fontsource/roboto": "5.3.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@supabase/supabase-js": "2.119.0",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-table": "8.21.3",
    "i18next": "27.1.3",
    "qrcode-generator": "2.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "18.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
